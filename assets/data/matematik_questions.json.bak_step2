  {
    "id": "mat_t7_q12",
    "courseId": "matematik",
    "testNum": 7,
    "qNum": 12,
    "subtopicTitle": "1. Konu: Sayı Basamakları ve Çözümleme II",
    "difficulty": "Orta",
    "question": "Üç basamaklı bir doğal sayının yüzler ve onlar basamağındaki rakamlar yer değiştirdiğinde sayı 180 azalıyor.\n\nBuna göre, bu koşula uyan kaç farklı üç basamaklı sayı yazılabilir?",
